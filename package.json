{
  "name": "seichi-portal-frontend",
  "version": "0.3.9",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "fmt": "prettier --check --log-level=warn './**/*.{ts,tsx,css}'",
    "fmt:fix": "prettier --write --log-level=warn './**/*.{ts,tsx,css}'",
    "pretty": "pnpm lint:fix && pnpm fmt:fix && pnpm build",
    "type-check": "tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:component && pnpm test:e2e",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:component": "vitest run --config vitest.component.config.ts",
    "test:e2e": "playwright test",
    "codegen": "tsx scripts/codegen.ts",
    "codegen:check": "tsx scripts/codegen.ts && git diff --exit-code src/generated"
  },
  "dependencies": {
    "@azure/msal-browser": "^4.30.0",
    "@azure/msal-react": "^3.0.29",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@grafana/faro-web-sdk": "^2.9.0",
    "@grafana/faro-web-tracing": "^2.9.0",
    "@hookform/resolvers": "^5.7.1",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@mui/material-nextjs": "^9.3.0",
    "@mui/x-data-grid": "^9.11.0",
    "@mui/x-date-pickers": "^9.11.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/instrumentation": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@pyroscope/nodejs": "^0.6.3",
    "@vercel/otel": "^2.1.3",
    "browserslist": "^4.28.8",
    "dayjs": "^1.11.22",
    "fp-ts": "^2.16.11",
    "next": "^16.3.2",
    "openapi-fetch": "^0.17.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "swr": "^2.5.1",
    "ts-pattern": "^5.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.3.2",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@tsconfig/strictest": "^2.0.8",
    "@types/eslint": "9.6.1",
    "@types/eslint-config-prettier": "^6.11.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "^16.3.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "^30.0.1",
    "lefthook": "^2.1.10",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.11"
  }
}
